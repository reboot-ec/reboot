project_name = "reboot"
environment  = "prod"

aws_region = "us-east-1"

vpc_cidr = "10.40.0.0/16"

public_subnet_cidrs = [
  "10.40.101.0/24",
  "10.40.102.0/24"
]

private_subnet_cidrs = [
  "10.40.1.0/24",
  "10.40.2.0/24"
]

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

identity_db_password     = "REPLACE_WITH_STRONG_IDENTITY_DB_PASSWORD"
organization_db_password = "REPLACE_WITH_STRONG_ORGANIZATION_DB_PASSWORD"

db_instance_class        = "db.t4g.medium"
db_allocated_storage      = 50
db_max_allocated_storage  = 100

backup_retention_period = 14

multi_az            = true
deletion_protection = true
skip_final_snapshot = false
directory_name     = "reboot.prod.local"
directory_password = "REPLACE_WITH_STRONG_DIRECTORY_PASSWORD"

# Use the AWS Academy LabRole ARN for ECS execution and task permissions.
task_execution_role_arn = "arn:aws:iam::123456789012:role/LabRole"

# Override either tag with a fixed release, for example "v1.0.0".
identity_image_tag     = "prod"
organization_image_tag = "prod"

jwt_secret = "REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET"

cors_allowed_origins = [
  "https://web.example.com",
  "https://desktop.example.com",
  "https://mobile.example.com"
]

# Provide these secrets via TF_VAR_n8n_db_password and TF_VAR_n8n_encryption_key.
# n8n_db_password    = "<set outside version control>"
# n8n_encryption_key = "<set outside version control>"
